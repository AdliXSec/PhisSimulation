# ============================================
# PhiSimulation Backend Environment Variables
# ============================================

# App
APP_NAME=PhiSimulation
APP_ENV=development
DEBUG=true
SECRET_KEY=YOUR_SECRET_KEY_HERE
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://phisim_admin:phisim_secret_2026@localhost:5433/phisimulation

# JWT
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI - OpenRouter (DeepSeek V3.2)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# Email - SMTP Settings
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@phisimulation.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Email - Resend API
RESEND=false
RESEND_API_KEY=re_123456789

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend URL (for CORS & tracking links)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Auth Hardening
ALLOWED_AUTH_DOMAIN=company.com
REGISTRATION_SECRET=some_secret_token_here
